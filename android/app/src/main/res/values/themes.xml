<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark from the first frame, so there's no white flash before Compose draws. -->
    <style name="Theme.Iris" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/iris_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <color name="iris_bg">#07070B</color>
</resources>
